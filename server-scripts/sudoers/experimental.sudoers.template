# HomeOps experimental profile.
# Install manually with: sudo visudo -f /etc/sudoers.d/homeops-agent
# Replace HOMEOPS_USER with the inventory user or a dedicated homeops/labagent user.

HOMEOPS_USER ALL=(root) NOPASSWD: /usr/bin/unattended-upgrade
HOMEOPS_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart -- AgentDVR.service
HOMEOPS_USER ALL=(root) NOPASSWD: /usr/sbin/shutdown -r +1 HomeOps-approved-reboot

# Future logged admin mode can intentionally widen this profile. Keep broad
# sudo disabled until the controller records command intent, stdout, stderr,
# exit code, and approval metadata for arbitrary commands.
# HOMEOPS_USER ALL=(root) NOPASSWD: ALL
